# HemoFlow — modelo de variáveis de ambiente.
# Copie os nomes para o painel da hospedagem (ou para um arquivo .env local, que NÃO vai para o Git).
# Nunca coloque senhas reais neste arquivo.

# development (computador local) | production (nuvem)
HEMOFLOW_ENV=production

# Endereço público com https:// — usado no link de "Esqueceu sua senha?"
HEMOFLOW_PUBLIC_URL=https://seu-endereco.exemplo.com

# Porta: a maioria das plataformas define PORT sozinha; só preencha se for necessário.
# HEMOFLOW_PORT=8000

# ---- Banco MySQL (dados do painel do provedor) ----
HEMOFLOW_DB_HOST=servidor-mysql.exemplo.com
HEMOFLOW_DB_PORT=3306
HEMOFLOW_DB_NAME=hemoflow
HEMOFLOW_DB_USER=hemoflow_app
HEMOFLOW_DB_PASSWORD=troque-pela-senha-no-painel
# TLS com o banco: required (padrão em produção) | verify (exige o certificado abaixo)
# | preferred (padrão local) | disabled (só rede privada; o MySQL 8 pode recusar a autenticação sem TLS)
HEMOFLOW_DB_SSL=required
# HEMOFLOW_DB_SSL_CA=/caminho/ca.pem        (arquivo do certificado do provedor)
# HEMOFLOW_DB_SSL_CA_PEM=-----BEGIN CERTIFICATE-----\n...   (ou o texto do certificado)
HEMOFLOW_DB_POOL_SIZE=5

# ---- Rede ----
# 1 = confiar no X-Forwarded-For do proxy HTTPS da hospedagem (padrão em produção)
HEMOFLOW_TRUST_PROXY=1
# Quantos proxies a plataforma coloca na frente do app (normalmente 1)
HEMOFLOW_PROXY_HOPS=1

# Fuso para vencimentos e datas
HEMOFLOW_TZ=America/Recife

# ---- E-mail para recuperação de senha (opcional) ----
# Gmail: use uma "senha de app", nunca a senha normal da conta.
HEMOFLOW_EMAIL_USER=
HEMOFLOW_EMAIL_PASSWORD=
HEMOFLOW_EMAIL_HOST=smtp.gmail.com
HEMOFLOW_EMAIL_PORT=587
