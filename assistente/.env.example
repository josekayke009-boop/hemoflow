# Assistente HemoFlow — copie para .env (copy .env.example .env) e preencha.
# O .env é PESSOAL: nunca envie para ninguém nem publique no GitHub.

# Chave da IA (OpenAI). Crie em platform.openai.com > API keys (precisa de crédito na conta).
OPENAI_API_KEY=sua-chave-aqui
LLM_MODELO=gpt-4o-mini
# Outro provedor compatível (opcional): deixe a linha abaixo vazia para usar a OpenAI.
LLM_BASE_URL=

# Banco do HemoFlow (padrão da Aula 7). Use um usuário do MySQL SÓ DE LEITURA.
HEMOFLOW_DB_HOST=127.0.0.1
HEMOFLOW_DB_PORT=3306
HEMOFLOW_DB_NAME=hemoflow
HEMOFLOW_DB_USER=hemoflow_leitura
HEMOFLOW_DB_PASSWORD=

# Serviço local usado pela aba "Assistente" do app (o HemoFlow precisa do mesmo segredo).
ASSISTENTE_PORTA=8765
ASSISTENTE_SEGREDO=
